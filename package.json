{
  "name": "tokengotchi",
  "version": "0.2.0",
  "description": "Um bichinho de estimação de desktop alimentado pelos tokens que você gasta com agentes de IA.",
  "author": "Vitor Rodrigues",
  "license": "MIT",
  "homepage": "https://github.com/vitorjpr/tokengotchi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorjpr/tokengotchi.git"
  },
  "bugs": {
    "url": "https://github.com/vitorjpr/tokengotchi/issues"
  },
  "keywords": [
    "electron",
    "macos",
    "tamagotchi",
    "virtual-pet",
    "tokens",
    "claude-code",
    "codex",
    "cursor",
    "menubar"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/main/main.js",
  "desktopName": "tokengotchi.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/selftest.js",
    "doctor": "node scripts/doctor.js",
    "icon": "node scripts/make-icon.js",
    "sprites": "node scripts/make-sprites.js",
    "dist": "electron-builder --mac --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.tokengotchi.app",
    "productName": "Tokengotchi",
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "synopsis": "Bichinho de desktop alimentado pelos tokens que voce gasta com agentes de IA",
      "syncDesktopName": true,
      "executableName": "tokengotchi",
      "maintainer": "Vitor Rodrigues <vitorjprodrigues97@gmail.com>"
    },
    "publish": null,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Tokengotchi",
      "artifactName": "Tokengotchi-Setup-${version}.${ext}"
    }
  }
}
